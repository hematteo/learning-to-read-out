# NOTE: nothing in this repo auto-loads .env files (no python-dotenv); all code
# reads plain os.environ. To use this file, copy it to .env and export the
# variables into your shell before launching:
#   set -a; source .env; set +a
# (or export each variable individually: `export UM_SSD_ROOT=...`).

# Optional snapshot/output root for W_U / W_E tensors.
# If unset, src/readout/core/paths.py defaults to <repo>/local_snapshots.
# Prefer an absolute path: a relative value resolves against the launch cwd,
# not the repo root.
UM_SSD_ROOT=/absolute/path/to/local_snapshots

# Optional Hugging Face cache locations.
# HF_HOME=~/.cache/huggingface
# HF_HUB_CACHE=~/.cache/huggingface/hub
