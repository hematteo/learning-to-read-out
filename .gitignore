# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/
*.egg-info/

# Secrets / local env
.env
.env.local
.env.*.local

# Model checkpoints / large tensors
*.ckpt
*.safetensors
checkpoints/
outputs/
wandb/
# Default UM_SSD_ROOT output root (W_U snapshots, releases) — see src/core/paths.py
local_snapshots/
snapshots/
hf_release/

# OS
.DS_Store

# LaTeX intermediates (keep .tex and .pdf, drop the rest)
*.aux
*.log
*.out
*.toc
*.fdb_latexmk
*.fls
*.synctex.gz
*.bbl
*.blg
*.fff
*.lof
*.lot
*.nav
*.snm
*.vrb
*.idx
*.ind
*.ilg
*.glo
*.gls
*.acn
*.acr
*.alg
*.xdv
texput.log

# Backup files
*.bak

# Underscore-prefix dirs are conventionally agent-skip / non-publishable
**/_derived/
**/_scratch/
_logs/

# Third-party / large
# llamascopium (OpenMOSS Language-Model-SAEs, MIT) is vendored and TRACKED so the
# repo installs from a clean clone; see docs/THIRD_PARTY.md. Ignore only its artefacts.
lib/Language-Model-SAEs/.venv/
lib/Language-Model-SAEs/**/__pycache__/
lib/Language-Model-SAEs/.ruff_cache/
lib/Language-Model-SAEs/.pytest_cache/
lib/Language-Model-SAEs/.mypy_cache/
results/
cache/

# LaTeX build output (artifacts live under paper/build/)
paper/build/

# Stale assets kept locally, not in version control
_archive/

# Overleaf round-trip exports (live in papers/ instead)
overleaf_main_report_*/
overleaf_main_report_*.zip
paper_overleaf_upload/
paper_overleaf_upload*.zip

# Dated paper PDF snapshots — keep only paper/main.pdf in version control
paper/main-*.pdf
*.ptc

# Internal handoff notes — keep local, not for public distribution
docs/internal/

# Editor
.vscode/
.idea/
*.swp

# IDE / agent assistant files
.claude/

# Local Netlify folder
.netlify

# Generated figure outputs — regenerate via experiment scripts (ships empty)
figures/

# Bulk eval/results artifacts that shouldn't ship with the public repo
experiments/crosscoders/crosscoder_main/derived/appendix_validation/large_evals/*.pt

# Public-release prune: the paper itself (linked as a preprint, not shipped in the
# code repo), internal lab reports, and result artifacts. This is a CODE-ONLY
# release: no data and no derived metrics ship. The per-figure metric sidecars
# (.csv/.json) are regenerated by running the experiment scripts, not committed.
/paper/
/reports/
/docs/reports/
*.parquet
**/derived/**/*.pt
**/derived/**/*.pth
**/derived/**/*.npy
**/derived/**/*.npz
**/derived/**/*.pdf
**/derived/**/*.png
**/derived/**/*.csv
**/derived/**/*.json
**/derived/**/*.txt

# Experiment outputs are regenerated, not source — code only, no metrics ship
# (see docs/DATA.md / docs/REPRODUCE.md for regeneration).
experiments/**/*.pt
experiments/**/*.pth
experiments/**/*.npy
experiments/**/*.npz
experiments/**/*.png
experiments/**/*.pdf
